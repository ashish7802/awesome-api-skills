{
  "name": "@awesome-api-skills/docs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate.js && vitepress dev src --host 0.0.0.0 --port 3000",
    "build": "node scripts/generate.js && vitepress build src --outDir ../../dist",
    "serve": "vitepress serve src --host 0.0.0.0 --port 3000",
    "analyze": "vitepress build src && npx vite-bundle-visualizer -o bundle-stats.html"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vitepress": "^1.6.4",
    "@awesome-api-skills/core": "*",
    "@awesome-api-skills/shared-types": "*",
    "@awesome-api-skills/validator": "*",
    "@awesome-api-skills/generator": "*"
  },
  "devDependencies": {
    "lighthouse": "^13.4.1",
    "vite-bundle-visualizer": "^1.2.1"
  }
}
