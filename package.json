{
  "name": "awesome-api-skills",
  "version": "0.0.0",
  "private": true,
  "description": "A collection of structured API skills for AI coding agents.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "cli": "node packages/cli/dist/bin.js",
    "build": "npm run build --workspace=@awesome-api-skills/docs",
    "dev": "npm run dev --workspace=@awesome-api-skills/docs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "validate:skills": "node packages/cli/dist/bin.js validate",
    "benchmark": "node scripts/dev/benchmark.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "prettier": "^3.4.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
